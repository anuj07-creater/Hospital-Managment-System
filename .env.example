# Server Configuration
PORT=3000
NODE_ENV="development"

# MongoDB Database Connection
# Provide your MongoDB Atlas or local MongoDB connection URI:
# Format: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=""

# JWT Authentication
# Set your secure secret key for signing JSON Web Tokens:
JWT_SECRET=""
JWT_EXPIRE="7d"

# GEMINI_API_KEY: Optional/reserved for clinical AI summarization
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL=""
